# Copy to .env.local (never commit .env.local). All values are optional: with none of them the
# app runs fully local with the built-in simulator and the local voice interpreter.

# Supabase — public values, safe for the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Gemini text-to-speech: the voice of BUZZ. Without a key BUZZ uses the browser voice.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck

# Demo-only shared code that the flight-psychologist role must present to read psych data
PSYCH_ACCESS_CODE=
